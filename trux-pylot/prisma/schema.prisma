generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PROFESSIONAL
  ADMIN
}

enum VerificationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  MORE_INFO_REQUIRED
}

enum JobStatus {
  REQUESTED
  QUOTED
  ACCEPTED
  PAYMENT_PENDING
  PAID
  IN_PROGRESS
  COMPLETED
  CUSTOMER_CONFIRMED
  SETTLED
  CANCELLED
  DISPUTED
  REFUNDED
  REJECTED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

// id is NOT auto-generated — it is always set explicitly to match the
// corresponding Supabase Auth user's id, so this row and the Supabase
// auth.users row for the same person share one id. Created only after
// a successful email OTP verification (see app/api/auth/otp/verify),
// so there is no separate "unverified" state to track here.
model User {
  id String @id
  email String @unique
  phone String? @unique
  role Role
  status UserStatus @default(ACTIVE)
  suspendedUntil DateTime?
  suspensionReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer Customer?
  professional Professional?
  notifications Notification[]
  auditLogs AuditLog[]
}

enum AccountType {
  INDIVIDUAL
  BUSINESS
}

enum ServiceRequestStatus {
  SUBMITTED
  CSD_REVIEWING
  AVAILABILITY_CONFIRMATION
  PROFESSIONAL_CONFIRMED
  CONNECTED
  COMPLETED
  DECLINED
  CANCELLED
}

model Customer {
  id String @id @default(cuid())
  userId String @unique
  fullName String
  accountType AccountType @default(INDIVIDUAL)
  businessName String?
  registrationNumber String?
  avatarUrl String? @db.Text
  country String?
  state String?
  city String?
  area String?
  street String?
  location String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs Job[]
  reviews Review[]
  serviceRequests ServiceRequest[]
}

model Professional {
  id String @id @default(cuid())
  userId String @unique
  fullName String
  accountType AccountType @default(INDIVIDUAL)
  businessName String?
  registrationNumber String?
  avatarUrl String? @db.Text
  profession String?
  bio String?
  country String?
  state String?
  city String?
  area String?
  street String?
  location String?
  yearsExperience Int?
  verificationStatus VerificationStatus @default(DRAFT)
  rating Float @default(0)
  completedJobs Int @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  services ProfessionalService[]
  jobs Job[]
  reviews Review[]
  verificationRequests VerificationRequest[]
  serviceRequests ServiceRequest[]
  reports ProfessionalReport[]
  wallet Wallet?
}

// A "Request Service" submission from a professional's public profile.
// Deliberately separate from Job/JobStatus: this never touches the
// professional directly. Truxpylot's Customer Service/Disburser (CSD) —
// handled by ADMIN accounts, no new role — reviews it, verifies
// availability off-platform, and only then connects the two parties.
// Converting a connected request into an actual paid Job (existing
// pipeline) is a manual step for CSD, not automatic.
model ServiceRequest {
  id String @id @default(cuid())
  customerId String
  professionalId String
  categoryId String
  description String
  location String
  preferredDate DateTime?
  preferredTime String?
  additionalRequirements String?
  status ServiceRequestStatus @default(SUBMITTED)
  csdNotes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer Customer @relation(fields: [customerId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])
  category ServiceCategory @relation(fields: [categoryId], references: [id])
  @@index([status, createdAt])
}

// A customer report about a professional, reviewed by CSD/admin.
model ProfessionalReport {
  id String @id @default(cuid())
  professionalId String
  customerId String?
  reason String
  description String
  status String @default("OPEN")
  createdAt DateTime @default(now())
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}

model ServiceCategory {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  description String?
  active Boolean @default(true)
  professionals ProfessionalService[]
  jobs Job[]
  serviceRequests ServiceRequest[]
}

model ProfessionalService {
  id String @id @default(cuid())
  professionalId String
  categoryId String
  startingPrice Int?
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id])
  @@unique([professionalId, categoryId])
}

model VerificationRequest {
  id String @id @default(cuid())
  professionalId String
  status VerificationStatus @default(SUBMITTED)
  notes String?
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  documents VerificationDocument[]
}

model VerificationDocument {
  id String @id @default(cuid())
  requestId String
  privateKey String
  mimeType String
  size Int
  request VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model Job {
  id String @id @default(cuid())
  customerId String
  professionalId String?
  categoryId String
  description String
  location String
  preferredAt DateTime?
  budget Int?
  status JobStatus @default(REQUESTED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer Customer @relation(fields: [customerId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])
  category ServiceCategory @relation(fields: [categoryId], references: [id])
  quotes Quote[]
  payment Payment?
  review Review?
  dispute Dispute?
  @@index([status, createdAt])
}

model Quote {
  id String @id @default(cuid())
  jobId String
  amount Int
  status String @default("PENDING")
  createdAt DateTime @default(now())
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Payment {
  id String @id @default(cuid())
  jobId String @unique
  reference String @unique
  amount Int
  commission Int
  status PaymentStatus @default(PENDING)
  providerEventId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Wallet {
  id String @id @default(cuid())
  professionalId String @unique
  availableBalance Int @default(0)
  pendingBalance Int @default(0)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}

model Review {
  id String @id @default(cuid())
  jobId String @unique
  customerId String
  professionalId String
  rating Int
  review String?
  createdAt DateTime @default(now())
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])
}

model Dispute {
  id String @id @default(cuid())
  jobId String @unique
  openedById String
  reason String
  description String
  status DisputeStatus @default(OPEN)
  resolution String?
  createdAt DateTime @default(now())
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Notification {
  id String @id @default(cuid())
  userId String
  type String
  title String
  body String
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id String @id @default(cuid())
  userId String?
  action String
  entity String
  entityId String?
  data Json?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id])
}
