generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PROFESSIONAL
  ADMIN
}

enum VerificationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  MORE_INFO_REQUIRED
}

enum JobStatus {
  REQUESTED
  QUOTED
  ACCEPTED
  PAYMENT_PENDING
  PAID
  IN_PROGRESS
  COMPLETED
  CUSTOMER_CONFIRMED
  SETTLED
  CANCELLED
  DISPUTED
  REFUNDED
  REJECTED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  REJECTED
  EXPIRED
}

enum RewardStatus {
  PENDING
  APPROVED
  PAID
  VOID
}

enum WithdrawalStatus {
  REQUESTED
  REVIEWING
  APPROVED
  PAID
  REJECTED
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum WalletTransactionSource {
  FUNDING
  JOB_EARNING
  REFERRAL_REWARD
  PROMOTED_TOP10
  WITHDRAWAL
  ADJUSTMENT
  DVA_TRANSFER
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

// id is NOT auto-generated — it is always set explicitly to match the
// corresponding Supabase Auth user's id, so this row and the Supabase
// auth.users row for the same person share one id. Created only after
// a successful email OTP verification (see app/api/auth/otp/verify),
// so there is no separate "unverified" state to track here.
model User {
  id String @id
  email String @unique
  phone String? @unique
  role Role
  status UserStatus @default(ACTIVE)
  suspendedUntil DateTime?
  suspensionReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer Customer?
  professional Professional?
  notifications Notification[]
  auditLogs AuditLog[]
  sentMessages Message[]
  bookingsAsCustomer Booking[] @relation("CustomerBookings")
  bookingsAsProfessional Booking[] @relation("ProfessionalBookings")
  referralCodes ReferralCode[]
  referralsSent Referral[] @relation("ReferralReferrer")
  referralReceived Referral? @relation("ReferralReferred")
  referralAttribution ReferralAttribution?
  referralRewards Reward[]
  referralMilestoneAchievements ReferralMilestoneAchievement[]
  withdrawals Withdrawal[]
}

enum AccountType {
  INDIVIDUAL
  BUSINESS
}

enum BusinessTeamRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  TECHNICIAN
  SUPPORT
}

enum BusinessTeamStatus {
  INVITED
  ACTIVE
  INACTIVE
}

enum ServiceRequestStatus {
  SUBMITTED
  CSD_REVIEWING
  AVAILABILITY_CONFIRMATION
  PROFESSIONAL_CONFIRMED
  CONNECTED
  COMPLETED
  DECLINED
  CANCELLED
}

model Customer {
  id String @id @default(cuid())
  userId String @unique
  fullName String
  accountType AccountType @default(INDIVIDUAL)
  businessName String?
  registrationNumber String?
  avatarUrl String? @db.Text
  country String?
  state String?
  city String?
  area String?
  street String?
  location String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs Job[]
  reviews Review[]
  serviceRequests ServiceRequest[]
  conversationsAsCustomer Conversation[] @relation("CustomerConversations")
}

model Professional {
  id String @id @default(cuid())
  userId String @unique
  fullName String
  accountType AccountType @default(INDIVIDUAL)
  businessName String?
  registrationNumber String?
  avatarUrl String? @db.Text
  profession String?
  bio String?
  country String?
  state String?
  city String?
  area String?
  street String?
  location String?
  yearsExperience Int?
  verificationStatus VerificationStatus @default(DRAFT)
  rating Float @default(0)
  completedJobs Int @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  services ProfessionalService[]
  jobs Job[]
  reviews Review[]
  verificationRequests VerificationRequest[]
  serviceRequests ServiceRequest[]
  reports ProfessionalReport[]
  wallet Wallet?
  dedicatedAccount DedicatedAccount?
  promotedListings PromotedListing[]
  premiumPurchases PremiumPurchase[]
  portfolioItems PortfolioItem[]
  conversationsAsProfessional Conversation[] @relation("ProfessionalConversations")
  ownedTeamMembers TeamMember[] @relation("BusinessTeam")
  teamMemberships TeamMember[] @relation("ProfessionalTeamMemberships")
}

model TeamMember {
  id             String            @id @default(cuid())
  businessId     String
  professionalId String?
  email          String
  role           BusinessTeamRole  @default(STAFF)
  status         BusinessTeamStatus @default(INVITED)
  invitedAt      DateTime          @default(now())
  joinedAt       DateTime?
  deactivatedAt  DateTime?
  business       Professional      @relation("BusinessTeam", fields: [businessId], references: [id], onDelete: Cascade)
  professional   Professional?     @relation("ProfessionalTeamMemberships", fields: [professionalId], references: [id], onDelete: SetNull)

  @@unique([businessId, email])
  @@unique([businessId, professionalId])
  @@index([businessId, status])
}

model Conversation {
  id             String         @id @default(cuid())
  customerId     String
  professionalId String
  jobId          String?
  serviceRequestId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  customer       Customer       @relation("CustomerConversations", fields: [customerId], references: [id], onDelete: Cascade)
  professional   Professional   @relation("ProfessionalConversations", fields: [professionalId], references: [id], onDelete: Cascade)
  job            Job?           @relation(fields: [jobId], references: [id], onDelete: SetNull)
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  messages       Message[]

  @@unique([customerId, professionalId, jobId, serviceRequestId])
  @@index([customerId, updatedAt])
  @@index([professionalId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String       @db.Text
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, readAt])
}

model PortfolioItem {
  id             String       @id @default(cuid())
  professionalId String
  title          String
  description    String?
  imageUrl       String?      @db.Text
  approved       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, approved])
}

model PremiumPurchase {
  id              String        @id @default(cuid())
  professionalId  String
  reference       String        @unique
  amount          Int
  status          PaymentStatus @default(PENDING)
  providerEventId String?       @unique
  activatedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  professional    Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, status])
}

// A "Request Service" submission from a professional's public profile.
// Deliberately separate from Job/JobStatus: this never touches the
// professional directly. Truxpylot's Customer Service/Disburser (CSD) —
// handled by ADMIN accounts, no new role — reviews it, verifies
// availability off-platform, and only then connects the two parties.
// Converting a connected request into an actual paid Job (existing
// pipeline) is a manual step for CSD, not automatic.
model ServiceRequest {
  id String @id @default(cuid())
  customerId String
  professionalId String
  categoryId String
  description String
  location String
  preferredDate DateTime?
  preferredTime String?
  additionalRequirements String?
  status ServiceRequestStatus @default(SUBMITTED)
  csdNotes String?
  requiresProfessionalResponse Boolean @default(true)
  responseExcluded Boolean @default(false)
  responseExclusionReason String?
  responseAvailableAt DateTime?
  professionalRespondedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer Customer @relation(fields: [customerId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])
  category ServiceCategory @relation(fields: [categoryId], references: [id])
  conversations Conversation[]
  @@index([status, createdAt])
}

model Booking {
  id             String   @id @default(cuid())
  jobId          String   @unique
  customerId     String
  professionalId String
  startAt        DateTime
  endAt          DateTime
  status         String   @default("CONFIRMED")
  reminder24hAt  DateTime?
  reminder1hAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customer       User     @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  professional   User     @relation("ProfessionalBookings", fields: [professionalId], references: [id], onDelete: Cascade)
  @@index([professionalId, startAt, endAt])
  @@index([customerId, startAt])
}

// A customer report about a professional, reviewed by CSD/admin.
model ProfessionalReport {
  id String @id @default(cuid())
  professionalId String
  customerId String?
  reason String
  description String
  status String @default("OPEN")
  createdAt DateTime @default(now())
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}

model ServiceCategory {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  description String?
  active Boolean @default(true)
  professionals ProfessionalService[]
  jobs Job[]
  serviceRequests ServiceRequest[]
}

model ProfessionalService {
  id String @id @default(cuid())
  professionalId String
  categoryId String
  startingPrice Int?
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id])
  @@unique([professionalId, categoryId])
}

model VerificationRequest {
  id String @id @default(cuid())
  professionalId String
  status VerificationStatus @default(SUBMITTED)
  notes String?
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  documents VerificationDocument[]
}

model VerificationDocument {
  id String @id @default(cuid())
  requestId String
  privateKey String
  mimeType String
  size Int
  request VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model Job {
  id String @id @default(cuid())
  customerId String
  professionalId String?
  categoryId String
  description String
  location String
  preferredAt DateTime?
  budget Int?
  status JobStatus @default(REQUESTED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer Customer @relation(fields: [customerId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])
  category ServiceCategory @relation(fields: [categoryId], references: [id])
  quotes Quote[]
  payment Payment?
  review Review?
  dispute Dispute?
  conversations Conversation[]
  booking Booking?
  @@index([status, createdAt])
}

model Quote {
  id String @id @default(cuid())
  jobId String
  amount Int
  status String @default("PENDING")
  priceType String @default("FIXED")
  estimatedDuration String?
  availableAt DateTime?
  message String? @db.Text
  workDescription String? @db.Text
  createdAt DateTime @default(now())
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Payment {
  id String @id @default(cuid())
  jobId String @unique
  reference String @unique
  amount Int
  commission Int
  status PaymentStatus @default(PENDING)
  providerEventId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Wallet {
  id String @id @default(cuid())
  professionalId String @unique
  availableBalance Int @default(0)
  pendingBalance Int @default(0)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  fundings WalletFunding[]
  dedicatedAccount DedicatedAccount?
}

model DedicatedAccount {
  id String @id @default(cuid())
  professionalId String @unique
  walletId String @unique
  paystackCustomerCode String
  paystackAccountId String? @unique
  accountNumber String? @unique
  accountName String?
  bankName String?
  bankSlug String?
  active Boolean @default(true)
  lastSyncedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  incomingTransfers IncomingTransfer[]
  @@index([paystackCustomerCode])
}

model IncomingTransfer {
  id String @id @default(cuid())
  dedicatedAccountId String?
  reference String @unique
  amount Int
  currency String?
  status String @default("UNMATCHED")
  providerEventId String? @unique
  payload Json?
  matchedAt DateTime?
  createdAt DateTime @default(now())
  dedicatedAccount DedicatedAccount? @relation(fields: [dedicatedAccountId], references: [id], onDelete: SetNull)
  @@index([status, createdAt])
}

model WalletTransaction {
  id String @id @default(cuid())
  walletId String
  type WalletTransactionType
  source WalletTransactionSource
  status WalletTransactionStatus @default(COMPLETED)
  amount Int
  description String
  reference String? @unique
  metadata Json?
  createdAt DateTime @default(now())
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  promotedListing PromotedListing?
  @@index([walletId, createdAt])
  @@index([source, status])
}

model WalletFunding {
  id String @id @default(cuid())
  walletId String
  reference String @unique
  amount Int
  status PaymentStatus @default(PENDING)
  providerEventId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  @@index([walletId, status])
}

model PromotedProduct {
  id String @id @default(cuid())
  name String
  durationDays Int
  price Int
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  listings PromotedListing[]
  @@unique([durationDays])
}

model PromotedListing {
  id String @id @default(cuid())
  professionalId String
  productId String
  transactionId String? @unique
  startsAt DateTime
  expiresAt DateTime
  active Boolean @default(true)
  createdAt DateTime @default(now())
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  product PromotedProduct @relation(fields: [productId], references: [id])
  transaction WalletTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  @@index([active, expiresAt])
  @@index([professionalId, active])
}

model Review {
  id String @id @default(cuid())
  jobId String @unique
  customerId String
  professionalId String
  rating Int
  review String?
  createdAt DateTime @default(now())
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])
}

model Dispute {
  id String @id @default(cuid())
  jobId String @unique
  openedById String
  reason String
  description String
  status DisputeStatus @default(OPEN)
  resolution String?
  createdAt DateTime @default(now())
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Notification {
  id String @id @default(cuid())
  userId String
  type String
  title String
  body String
  link String?
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt])
}

model AuditLog {
  id String @id @default(cuid())
  userId String?
  action String
  entity String
  entityId String?
  data Json?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id])
}

model ReferralCampaign {
  id String @id @default(cuid())
  name String
  description String?
  active Boolean @default(true)
  rewardAmount Int @default(0)
  qualificationJobs Int @default(1)
  maxRewardCap Int?
  startsAt DateTime?
  endsAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  codes ReferralCode[]
  milestones ReferralMilestone[]
  achievements ReferralMilestoneAchievement[]
  rewards Reward[]
  referrals Referral[]
}

model ReferralMilestone {
  id String @id @default(cuid())
  campaignId String
  name String
  threshold Int
  rewardAmount Int
  qualifiedCountTrigger Int
  totalMilestoneValue Int
  incrementalAmount Int
  campaign ReferralCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  rewards Reward[]
  achievements ReferralMilestoneAchievement[]
  @@unique([campaignId, threshold])
}

model ReferralCode {
  id String @id @default(cuid())
  code String @unique
  ownerId String
  campaignId String?
  active Boolean @default(true)
  clicks Int @default(0)
  createdAt DateTime @default(now())
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  campaign ReferralCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  attributions ReferralAttribution[]
  referrals Referral[]
  @@index([ownerId, active])
}

model ReferralAttribution {
  id String @id @default(cuid())
  codeId String
  referredUserId String @unique
  source String?
  landingPath String?
  metadata Json?
  createdAt DateTime @default(now())
  code ReferralCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  referredUser User @relation(fields: [referredUserId], references: [id], onDelete: Cascade)
}

model Referral {
  id String @id @default(cuid())
  codeId String
  referrerId String
  referredId String @unique
  campaignId String?
  status ReferralStatus @default(PENDING)
  qualifiedAt DateTime?
  rewardedAt DateTime?
  rejectionReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  code ReferralCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  referrer User @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("ReferralReferred", fields: [referredId], references: [id], onDelete: Cascade)
  campaign ReferralCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  rewards Reward[]
  @@index([referrerId, status])
  @@index([status, createdAt])
}

model Reward {
  id String @id @default(cuid())
  referralId String?
  userId String
  milestoneId String?
  campaignId String?
  achievementId String? @unique
  qualifiedCountTrigger Int?
  totalMilestoneValue Int?
  incrementalAmount Int?
  amount Int
  status RewardStatus @default(PENDING)
  reason String
  approvedById String?
  paidAt DateTime?
  reversedAt DateTime?
  createdAt DateTime @default(now())
  referral Referral? @relation(fields: [referralId], references: [id], onDelete: SetNull)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestone ReferralMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  campaign ReferralCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  achievement ReferralMilestoneAchievement?
  @@index([userId, status])
  @@unique([userId, campaignId, milestoneId])
}

model ReferralMilestoneAchievement {
  id String @id @default(cuid())
  campaignId String
  milestoneId String
  userId String
  qualifiedCount Int
  totalMilestoneValue Int
  incrementalAmount Int
  achievedAt DateTime @default(now())
  reversedAt DateTime?
  rewardId String @unique
  campaign ReferralCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  milestone ReferralMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  @@unique([campaignId, userId, milestoneId])
  @@index([userId, campaignId])
}

model Withdrawal {
  id String @id @default(cuid())
  userId String
  amount Int
  status WithdrawalStatus @default(REQUESTED)
  bankName String?
  accountName String?
  accountNumber String?
  reviewedById String?
  reviewedAt DateTime?
  paidAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
  @@index([userId, status])
}
