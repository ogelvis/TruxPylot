# Copy this file to .env (local) or set these in your deploy platform's
# Environment tab (e.g. Render). See README-FIX.md for the full setup guide.

# --- Database (Prisma / Postgres, e.g. from Supabase) ---
DATABASE_URL=

# --- App session signing (tp_session cookie, lib/auth.ts) ---
AUTH_SECRET=

# --- Supabase Auth (email OTP, lib/otp.ts) — anon/public key only ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Supabase Storage (lib/storage.ts) — SERVICE ROLE key, server-only.
# Required for avatar uploads AND for the admin verification document
# viewer (getVerificationDocumentUrl / GET /api/admin/documents/[id]) to
# generate signed URLs. Never expose this to the browser. ---
SUPABASE_SERVICE_ROLE_KEY=

# --- One-time admin bootstrap (app/api/admin/bootstrap, app/api/admin/diagnostics) ---
ADMIN_BOOTSTRAP_SECRET=

# --- Paystack (app/api/payments/*) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Used to build the Paystack callback_url after payment initialization.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — platform commission percentage applied to job payments (lib/jobs.ts).
# Defaults to 10 if unset.
PLATFORM_COMMISSION_PERCENT=10
